# MarketMate SPA, served by nginx.
#
# At the repository root so the build context is the whole repo, matching what
# the platform stack passes. market-mate-fe/Dockerfile still exists and builds
# the same app standalone; this one differs only in context and in listening on
# the port the platform contract publishes.

FROM node:22-alpine AS build
WORKDIR /fe

COPY market-mate-fe/package*.json ./
RUN npm ci

COPY market-mate-fe/ ./
# Empty base URL means same-origin, and nginx below proxies /api to the backend.
# Baking a hostname in at build time would tie the bundle to one deployment.
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /fe/dist /usr/share/nginx/html

EXPOSE 5173

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:5173/healthz"]
