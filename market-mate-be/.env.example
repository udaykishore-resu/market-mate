# MarketMate backend configuration.
#
# Every value here is OPTIONAL. With none of them set, the server starts in
# demo mode and serves realistic fixture data for whichever providers have no
# key — so `go run ./cmd` works on a fresh clone with no signup.
#
# Copy to .env and fill in only what you have.

# --- Provider keys (each one independently upgrades that stage to live) ------

# https://console.cloud.google.com → enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.cloud.google.com → enable "Places API" (requires billing)
MAPS_API_KEY=

# --- Server ------------------------------------------------------------------

PORT=8080

# Comma-separated CORS allow-list. Add your deployed frontend origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true to force fixture data even when keys are present (screenshots,
# offline demos, deterministic tests).
DEMO_MODE=
