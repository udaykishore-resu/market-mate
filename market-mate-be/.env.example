# MarketMate backend configuration.
#
# Every value here is OPTIONAL. With none of them set, the server starts in
# demo mode and serves realistic fixture data for whichever providers have no
# key — so `go run ./cmd` works on a fresh clone with no signup, and with no
# database, cache or search cluster.
#
# Copy to .env and fill in only what you have.

# --- Provider keys (each one independently upgrades that stage to live) ------

# https://console.cloud.google.com → enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.cloud.google.com → enable "Places API" (requires billing)
MAPS_API_KEY=

# --- Server ------------------------------------------------------------------

PORT=8080

# Comma-separated CORS allow-list. Add your deployed frontend origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Set to true to force fixture data even when keys are present (screenshots,
# offline demos, deterministic tests). USE_FIXTURES is the platform contract's
# name for the same switch; either one turns it on.
DEMO_MODE=
USE_FIXTURES=

# --- Infrastructure (MM_*) ---------------------------------------------------
#
# Each of these is opt-in, and the fallback for each is a supported way to run:
#
#   MM_POSTGRES_DSN  unset → no durable cache; every miss re-fetches and
#                            re-extracts, as the service did before
#   MM_REDIS_ADDR    unset → the in-process go-cache (not shared, not durable)
#   MM_ELASTIC_URL   unset → substring search over Postgres, or no search at all
#                            when Postgres is also unset

# Permanent transcript and extraction cache. A video's transcript and the
# ingredient list extracted from it never change, so they are stored rather than
# expired: this is what stops repeat lookups re-billing YouTube and OpenAI.
MM_POSTGRES_DSN=
# Apply the embedded migrations on boot. Safe to leave on with several replicas:
# they serialise on a Postgres advisory lock.
MM_MIGRATE=true

# Shared store cache. Grocery results are time-sensitive, so this layer keeps a
# TTL where the two above are permanent. Keys are namespaced mm:v1:* and carry a
# precision-5 geohash (~5km cell) rather than a rounded coordinate.
MM_REDIS_ADDR=
MM_REDIS_PASSWORD=
# The platform contract gives MarketMate logical DB 1; Guest Score uses 0.
MM_REDIS_DB=1
MM_STORE_CACHE_TTL=15m

# Recipe and ingredient search.
MM_ELASTIC_URL=
MM_ELASTIC_INDEX=marketmate-recipes

# GraphQL at POST /graphql. GraphiQL is an unauthenticated schema browser, so it
# defaults off even though the endpoint defaults on.
MM_GRAPHQL=true
MM_GRAPHIQL=

# --- Tests -------------------------------------------------------------------

# The storage integration tests skip unless this points at a real database.
# They create and delete their own rows; do not point it at anything you mind
# being written to.
# MM_TEST_POSTGRES_DSN=postgres://marketmate:marketmate@localhost:5432/marketmate?sslmode=disable
